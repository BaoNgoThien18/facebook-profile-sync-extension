{
  "manifest_version": 3,
  "name": "bug sync - facebook",
  "version": "1.7.0",
  "description": "Đồng bộ profile Facebook cá nhân và các Page bạn quản lý nhanh chóng chỉ với 1 click.",
  "permissions": ["cookies", "storage", "tabs", "declarativeNetRequest"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://facebook.buglogin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "bug sync - facebook",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://business.facebook.com/*"
      ],
      "js": [
        "modules/facebook/profile-context.js",
        "modules/facebook/insights-metrics.js",
        "modules/facebook/page-assets.js",
        "modules/ui/status-toast.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/icon-48.png", "assets/icons/icon-32.png"],
      "matches": ["https://*.facebook.com/*", "https://business.facebook.com/*"]
    }
  ]
}
